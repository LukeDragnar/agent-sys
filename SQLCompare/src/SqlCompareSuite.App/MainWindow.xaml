<Window x:Class="SqlCompareSuite.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SQL Compare Suite — Schema &amp; Data"
        Height="760" Width="1200"
        Icon="app.png"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource RgContentBg}">
    <DockPanel>
        <!-- ===== Title + Menu gộp 1 hàng (gọn, tiết kiệm diện tích) ===== -->
        <DockPanel DockPanel.Dock="Top" Background="{StaticResource RgDark}">
            <DockPanel.Resources>
                <!-- MenuItem con: chữ tối để đọc được trên popup nền sáng -->
                <Style x:Key="SubItem" TargetType="MenuItem">
                    <Setter Property="Foreground" Value="#222222" />
                </Style>
            </DockPanel.Resources>
            <!-- Logo nhỏ (không lặp tên — title bar OS đã có) -->
            <Image DockPanel.Dock="Left" Source="app.png" Width="18" Height="18"
                   VerticalAlignment="Center" Margin="8,0,2,0" />
            <!-- Version bên phải -->
            <TextBlock x:Name="VersionText" DockPanel.Dock="Right" Text="" Foreground="#888888"
                       FontStyle="Italic" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0" />
            <!-- Menu chiếm phần giữa -->
            <Menu Background="Transparent" Foreground="White" VerticalAlignment="Center" Padding="6,2,0,2">
                <MenuItem Header="_File" Foreground="#DDDDDD">
                    <MenuItem Header="New Schema Compare" Click="NewSchemaButton_Click" Style="{StaticResource SubItem}" />
                    <MenuItem Header="New Data Compare" Click="NewDataButton_Click" Style="{StaticResource SubItem}" />
                    <Separator />
                    <MenuItem Header="Close Current Tab" Click="CloseTabButton_Click" Style="{StaticResource SubItem}" />
                    <Separator />
                    <MenuItem Header="Exit" Click="ExitMenu_Click" Style="{StaticResource SubItem}" />
                </MenuItem>
                <MenuItem Header="_Actions" Foreground="#DDDDDD">
                    <MenuItem Header="New Schema Compare" Click="NewSchemaButton_Click" Style="{StaticResource SubItem}" />
                    <MenuItem Header="New Data Compare" Click="NewDataButton_Click" Style="{StaticResource SubItem}" />
                </MenuItem>
                <MenuItem Header="_Tools" Foreground="#DDDDDD">
                    <MenuItem Header="(no tools yet)" IsEnabled="False" Style="{StaticResource SubItem}" />
                </MenuItem>
                <MenuItem Header="_Help" Foreground="#DDDDDD">
                    <MenuItem Header="About..." Click="AboutMenu_Click" Style="{StaticResource SubItem}" />
                </MenuItem>
            </Menu>
        </DockPanel>

        <!-- ===== Toolbar (tối, icon-text) ===== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource RgDark}"
                BorderBrush="#1E1E1E" BorderThickness="0,0,0,1" Padding="6,4">
            <DockPanel LastChildFill="False">
                <Button x:Name="NewSchemaButton" DockPanel.Dock="Left" Click="NewSchemaButton_Click"
                        Style="{StaticResource ToolbarIconButton}" Content="➕  New Schema Compare" />
                <Button x:Name="NewDataButton" DockPanel.Dock="Left" Click="NewDataButton_Click"
                        Style="{StaticResource ToolbarIconButton}" Content="🗋  New Data Compare" />
                <Border DockPanel.Dock="Left" Width="1" Background="#555555" Margin="6,3" />
                <Button x:Name="CloseTabButton" DockPanel.Dock="Left" Click="CloseTabButton_Click"
                        Style="{StaticResource ToolbarIconButton}" Content="✖  Close Tab" />
                <!-- Danh sách tab đang mở — tách hẳn ra toolbar, KHÔNG nằm cạnh dải tab -->
                <Button x:Name="TabListButton" DockPanel.Dock="Right" Click="TabListButton_Click"
                        Style="{StaticResource ToolbarIconButton}" Content="☰  Tabs"
                        ToolTip="Danh sách tab đang mở" />
            </DockPanel>
        </Border>

        <!-- ===== Footer (status bar) dưới cùng ===== -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource RgDark}"
                BorderBrush="#1E1E1E" BorderThickness="0,1,0,0" Height="26">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Nút mở lại panel (góc trái footer) — chỉ hiện khi panel đã thu gọn -->
                <Button Grid.Column="0" x:Name="ExpandPanelButton" Content="☰  Saved Connections"
                        Click="TogglePanelButton_Click" Visibility="Collapsed"
                        Style="{StaticResource ToolbarIconButton}" VerticalAlignment="Center"
                        Margin="4,0,0,0" ToolTip="Mở Saved Connections" />
                <TextBlock Grid.Column="2" Foreground="#888888" FontSize="11" VerticalAlignment="Center"
                           Margin="0,0,12,0" Text="file-based • NOLOCK reads" />
            </Grid>
        </Border>

        <!-- ===== Activity bar dọc (kiểu VS Code) ===== -->
        <Border DockPanel.Dock="Left" Background="#2D2D30" Width="46" BorderBrush="#1E1E1E" BorderThickness="0,0,1,0">
            <Border.Resources>
                <Style x:Key="ActBtn" TargetType="Button">
                    <Setter Property="Width" Value="46" />
                    <Setter Property="Height" Value="44" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="#C8C8C8" />
                    <Setter Property="FontSize" Value="20" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}">
                                    <Grid>
                                        <!-- Thanh accent trái: hiện khi button đang "active" (panel/tab đang chọn) -->
                                        <Border x:Name="accent" Width="4" HorizontalAlignment="Left"
                                                Background="#E97AA6" Visibility="Collapsed" />
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#37373D" />
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                    <!-- Active: Tag="active" → nền hồng đậm + accent trái + chữ trắng (rõ hẳn) -->
                                    <Trigger Property="Tag" Value="active">
                                        <Setter TargetName="bd" Property="Background" Value="#5A3247" />
                                        <Setter TargetName="accent" Property="Visibility" Value="Visible" />
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Border.Resources>
            <DockPanel>
                <!-- Nhóm dưới cùng -->
                <Button DockPanel.Dock="Bottom" Style="{StaticResource ActBtn}" Content="ⓘ"
                        Click="AboutMenu_Click" ToolTip="About" />
                <!-- Nhóm trên -->
                <StackPanel>
                    <Button Style="{StaticResource ActBtn}" Content="➕" Click="NewSchemaButton_Click"
                            ToolTip="New Schema Compare" />
                    <Button Style="{StaticResource ActBtn}" Content="🗃" Click="NewDataButton_Click"
                            ToolTip="New Data Compare" />
                    <Border Height="1" Background="#444" Margin="8,4" />
                    <Button x:Name="PanelActivityButton" Style="{StaticResource ActBtn}" Content="📁"
                            Tag="active" Click="TogglePanelButton_Click"
                            ToolTip="Saved Projects / Connections" />
                    <Button Style="{StaticResource ActBtn}" Content="🔄" Click="ActivityRefresh_Click"
                            ToolTip="Refresh / Compare (F5)" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Thân: panel trái (Saved Connections) | splitter | tab so sánh ===== -->
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Cột 0: panel trái. Toggle = đặt Width 220 ↔ 0. -->
                <ColumnDefinition x:Name="LeftPanelColumn" Width="220" MinWidth="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Panel trái: Saved Projects (trên) + Saved Connections (dưới) ===== -->
            <Border x:Name="LeftPanel" Grid.Column="0" Background="#FAFAFA"
                    BorderBrush="#DDDDDD" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Khu Saved Projects -->
                        <RowDefinition Height="*" MinHeight="120" />
                        <!-- Splitter ngang -->
                        <RowDefinition Height="Auto" />
                        <!-- Khu Saved Connections -->
                        <RowDefinition Height="*" MinHeight="120" />
                    </Grid.RowDefinitions>

                    <!-- ====== KHU 1: SAVED PROJECTS ====== -->
                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header tối nhỏ + nút thu gọn ◀ -->
                        <Border Grid.Row="0" Background="{StaticResource RgDark}" Padding="8,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Saved Projects" Foreground="White"
                                           FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                <Button Grid.Column="1" x:Name="CollapsePanelButton" Content="◀"
                                        Click="TogglePanelButton_Click" Style="{StaticResource ToolbarIconButton}"
                                        ToolTip="Thu gọn panel" />
                            </Grid>
                        </Border>

                        <!-- Danh sách project: nhóm theo Group; kéo-thả project vào group header để gán nhóm -->
                        <ListBox x:Name="SavedProjectList" Grid.Row="1" Margin="6" BorderThickness="1"
                                 BorderBrush="#DDDDDD" Background="White"
                                 PreviewMouseLeftButtonDown="SavedProject_PreviewMouseDown"
                                 MouseMove="SavedProject_MouseMove"
                                 MouseDoubleClick="SavedProjectList_MouseDoubleClick">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <!-- Header group = drop target. Tag = tên group để code đọc khi drop. -->
                                            <Border Background="#ECECEC" BorderBrush="#D5D5D5" BorderThickness="0,0,0,1"
                                                    Padding="6,3" AllowDrop="True" Tag="{Binding Name}"
                                                    DragOver="GroupHeader_DragOver" Drop="GroupHeader_Drop">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🗂" Margin="0,0,4,0" Foreground="#888" />
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#555" />
                                                    <TextBlock Foreground="#999" Margin="4,0,0,0">
                                                        <Run Text="(" /><Run Text="{Binding ItemCount, Mode=OneWay}" /><Run Text=")" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2">
                                        <!-- Project thật -->
                                        <StackPanel x:Name="RealRow">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="{Binding KindBrush}" CornerRadius="3" Padding="4,0" Margin="0,0,5,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Kind}" Foreground="White" FontSize="10" />
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#222"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Path}" FontSize="10" Foreground="#999"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                                        </StackPanel>
                                        <!-- Placeholder của group rỗng -->
                                        <TextBlock x:Name="EmptyRow" Text="(trống — kéo project vào đây)"
                                                   FontStyle="Italic" Foreground="#AAA" FontSize="11" Visibility="Collapsed" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                            <Setter TargetName="RealRow" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="EmptyRow" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Nút thao tác project -->
                        <StackPanel Grid.Row="2" Margin="6,0,6,8">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" x:Name="NewGroupButton" Content="🗂 New group"
                                        Click="NewGroupButton_Click" Margin="0,0,2,0"
                                        ToolTip="Tạo group mới; kéo project thả vào group header để gán" />
                                <Button Grid.Column="1" x:Name="RemoveGroupButton" Content="🗑 Group"
                                        Click="RemoveGroupButton_Click" Margin="2,0,0,0"
                                        ToolTip="Xoá group đang chọn (project trong group về 'Chưa nhóm')" />
                            </Grid>
                            <Button x:Name="AddProjectButton" Content="➕ Add existing…"
                                    Click="AddProjectButton_Click" Margin="0,0,0,4" HorizontalAlignment="Stretch"
                                    ToolTip="Thêm file .sqlcmp/.sqldcmp đã có vào danh sách" />
                            <Button x:Name="OpenProjectButton" Content="📂 Open"
                                    Click="OpenProjectButton_Click" Margin="0,0,0,4" HorizontalAlignment="Stretch" />
                            <Button x:Name="RemoveProjectButton" Content="🗑 Remove"
                                    Click="RemoveProjectButton_Click" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Grid>

                    <!-- ====== Splitter ngang chia 2 khu ====== -->
                    <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch"
                                  VerticalAlignment="Center" Background="#E0E0E0"
                                  ResizeBehavior="PreviousAndNext" ResizeDirection="Rows" />

                    <!-- ====== KHU 2: SAVED CONNECTIONS ====== -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header tối nhỏ -->
                        <Border Grid.Row="0" Background="{StaticResource RgDark}" Padding="8,5">
                            <TextBlock Text="Saved Connections" Foreground="White"
                                       FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                        </Border>

                        <!-- Danh sách connection đã lưu -->
                        <ListBox x:Name="SavedConnList" Grid.Row="1" Margin="6" BorderThickness="1"
                                 BorderBrush="#DDDDDD" Background="White"
                                 MouseDoubleClick="SavedConnList_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#222" />
                                        <TextBlock Text="{Binding SubText}" FontSize="11" Foreground="#777" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Nút thao tác -->
                        <StackPanel Grid.Row="2" Margin="6,0,6,8">
                            <Button x:Name="SaveCurrentConnButton" Content="＋ Save current"
                                    Click="SaveCurrentConnButton_Click" Margin="0,0,0,4" HorizontalAlignment="Stretch" />
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" x:Name="ApplySourceButton" Content="→ Source"
                                        Click="ApplySourceButton_Click" Margin="0,0,2,0" />
                                <Button Grid.Column="1" x:Name="ApplyTargetButton" Content="→ Target"
                                        Click="ApplyTargetButton_Click" Margin="2,0,0,0" />
                            </Grid>
                            <Button x:Name="RemoveConnButton" Content="🗑 Remove"
                                    Click="RemoveConnButton_Click" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ===== Splitter kéo rộng panel ===== -->
            <GridSplitter x:Name="LeftSplitter" Grid.Column="1" Width="4" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Background="#E0E0E0"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" />

            <!-- ===== Vùng tab so sánh ===== -->
            <Grid Grid.Column="2" Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <!-- cột nút ☰ (tách ra ngoài dải tab) -->
                </Grid.ColumnDefinitions>

                <!-- Khu tab (2 dòng: dải ghim trên + dải tab thường dưới) -->
                <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Dải tab GHIM (dòng trên; ẩn khi không có tab ghim) — style giống tab thường -->
                <ItemsControl x:Name="PinnedTabsStrip" Grid.Row="0" Visibility="Collapsed" Background="#D7D7D7">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" Margin="0,2,0,0" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Tab ghim GIỐNG HỆT tab thường (icon ⚙/▦ + tên + ✕). Khác DUY NHẤT: 📌 đầu dòng để bỏ ghim. -->
                            <Border x:Name="pbd" Background="#E6E6E6" BorderBrush="#C9C9C9"
                                    BorderThickness="1,1,1,0" CornerRadius="4,4,0,0"
                                    Margin="0,0,2,0" Padding="6,3" Cursor="Hand"
                                    MouseLeftButtonUp="PinnedTab_Click" Tag="{Binding}">
                                <!-- Chuột phải trên tab ghim: Bỏ ghim / Đóng -->
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="📌 Bỏ ghim" Click="PinnedTabUnpin_Click" Tag="{Binding}" />
                                        <MenuItem Header="✕ Đóng tab" Click="PinnedTabClose_Click" Tag="{Binding}" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <StackPanel Orientation="Horizontal">
                                    <!-- pin = điểm khác duy nhất so với tab thường → click bỏ ghim.
                                         VẼ vector (đầu tròn + mũi nhọn xuống) = pin CẮM DỌC, không phụ thuộc font/emoji -->
                                    <Button Click="PinnedTabUnpin_Click" Tag="{Binding}" Cursor="Hand"
                                            Width="8" Height="11" MinWidth="0" MinHeight="0"
                                            Margin="0,0,4,0" Padding="0" VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            Background="Transparent" BorderThickness="0" ToolTip="Bỏ ghim">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent"><ContentPresenter /></Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Grid Width="6" Height="10">
                                            <Ellipse Width="6" Height="6" Fill="#E97AA6" VerticalAlignment="Top" HorizontalAlignment="Center" />
                                            <Polygon Points="0,0 4,0 2,4" Fill="#E97AA6" VerticalAlignment="Bottom" HorizontalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                    <!-- chip icon tròn 18×18 theo loại — GIỐNG HỆT BuildHeader -->
                                    <Border Background="{Binding KindBrush}" CornerRadius="3" Width="18" Height="18"
                                            Margin="0,0,6,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding KindIcon}" Foreground="White" FontSize="11"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{Binding KindBrush}"
                                               VerticalAlignment="Center" Margin="0,0,3,0"
                                               TextTrimming="CharacterEllipsis" MaxWidth="170" />
                                    <!-- ✕ đóng — GIỐNG HỆT tab thường -->
                                    <Button Content="✕" Click="PinnedTabClose_Click" Tag="{Binding}" FontSize="8"
                                            Width="13" Height="13" MinWidth="0" Padding="0" Margin="0,0,-2,0"
                                            BorderThickness="0" Background="Transparent" Foreground="#999"
                                            VerticalAlignment="Center" Cursor="Hand" ToolTip="Đóng tab" />
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="pbd" Property="Background" Value="White" />
                                    <Setter TargetName="pbd" Property="BorderBrush" Value="#E97AA6" />
                                    <Setter TargetName="pbd" Property="BorderThickness" Value="1,2,1,0" />
                                    <Setter TargetName="pbd" Property="Panel.ZIndex" Value="1" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Grid.Row="1">
                <TabControl x:Name="Tabs" Background="Transparent" BorderThickness="0">
                    <!-- Tab phẳng gọn kiểu SSMS -->
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Margin" Value="0,0,2,0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="bd" Background="#E6E6E6" BorderBrush="#C9C9C9"
                                                BorderThickness="1,1,1,0" CornerRadius="4,4,0,0"
                                                Padding="6,3" Margin="{TemplateBinding Margin}" SnapsToDevicePixels="True">
                                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#F1F1F1" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="White" />
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#E97AA6" />
                                                <Setter TargetName="bd" Property="BorderThickness" Value="1,2,1,0" />
                                                <Setter TargetName="bd" Property="Panel.ZIndex" Value="1" />
                                            </Trigger>
                                            <Trigger Property="Tag" Value="pinned">
                                                <Setter TargetName="bd" Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <!-- Tab đã ghim → thu header ở dòng chính (vẫn selectable để content hiện) -->
                                <Trigger Property="Tag" Value="pinned">
                                    <Setter Property="Width" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TabControl.Resources>
                    <!-- 1 hàng ngang, KHÔNG wrap -->
                    <TabControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </TabControl.ItemsPanel>
                    <!-- Header 1 hàng cuộn ngang (tràn → dùng nút ☰); nội dung tab ở dưới -->
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#D7D7D7">
                                    <ScrollViewer x:Name="HeaderScroll" VerticalScrollBarVisibility="Disabled"
                                                  HorizontalScrollBarVisibility="Hidden" Margin="0,2,0,0"
                                                  PreviewMouseWheel="HeaderScroll_PreviewMouseWheel">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                                <!-- Nền nội dung: KHÔNG còn line hồng full; chỉ tab đang chọn mới có viền hồng -->
                                <Border Grid.Row="1" Background="White" BorderBrush="#C9C9C9" BorderThickness="0,1,0,0">
                                    <ContentPresenter ContentSource="SelectedContent" />
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </TabControl.Template>
                </TabControl>
                </Grid>
                </Grid>

                <Popup x:Name="TabListPopup" Grid.Column="1" PlacementTarget="{Binding ElementName=TabListButton}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                       HorizontalOffset="-234">
                    <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1" Padding="2"
                            SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.25" />
                        </Border.Effect>
                        <ListBox x:Name="TabListBox" Width="260" MaxHeight="320" BorderThickness="0"
                                 SelectionChanged="TabListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="2,3">
                                        <Border Background="{Binding KindBrush}" CornerRadius="3" Padding="4,0"
                                                Margin="0,0,6,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Kind}" Foreground="White" FontSize="10" />
                                        </Border>
                                        <TextBlock Text="{Binding Marker}" Foreground="#E97AA6"
                                                   VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <TextBlock Text="{Binding Title}" FontWeight="{Binding Weight}"
                                                   Foreground="#222" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Popup>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
