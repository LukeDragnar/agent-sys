<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>SqlCompareSuite</AssemblyName>
    <RootNamespace>SqlCompareSuite.App</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SqlCompareSuite.Core\SqlCompareSuite.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Logo app: PNG dùng cho Window.Icon + title bar; ICO dùng cho exe -->
    <Resource Include="app.png" />
  </ItemGroup>

</Project>
