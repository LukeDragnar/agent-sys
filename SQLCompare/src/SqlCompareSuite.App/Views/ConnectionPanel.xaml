<UserControl x:Class="SqlCompareSuite.App.Views.ConnectionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border BorderBrush="#CCC" BorderThickness="1" CornerRadius="4" Padding="8" Margin="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="HeaderText" Grid.Row="0" Grid.ColumnSpan="2"
                       Text="Source" FontWeight="Bold" FontSize="14"
                       Margin="0,0,0,6" />

            <Label Grid.Row="1" Grid.Column="0" Content="Server:" VerticalAlignment="Center" Margin="0,0,6,3" />
            <TextBox x:Name="ServerBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,3" />

            <Label Grid.Row="2" Grid.Column="0" Content="Database:" VerticalAlignment="Center" Margin="0,0,6,3" />
            <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="DatabaseBox" Grid.Column="0" IsEditable="True" />
                <Button x:Name="LoadDbButton" Grid.Column="1" Content="Load DB"
                        Click="LoadDbButton_Click" Margin="4,0,0,0" Padding="6,0" />
                <Button x:Name="TestButton" Grid.Column="2" Content="Test"
                        Click="TestButton_Click" Margin="4,0,0,0" Padding="6,0" MinWidth="48" />
            </Grid>

            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                <RadioButton x:Name="WindowsAuthRadio" Content="Windows Auth" IsChecked="True"
                             GroupName="Auth" Margin="0,0,12,0"
                             Checked="AuthRadio_Changed" VerticalAlignment="Center" />
                <RadioButton x:Name="SqlAuthRadio" Content="SQL Auth"
                             GroupName="Auth"
                             Checked="AuthRadio_Changed" VerticalAlignment="Center" />
            </StackPanel>

            <Grid Grid.Row="4" Grid.Column="1" Margin="0,3,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="User:" VerticalAlignment="Center" Margin="0,0,6,3" />
                <TextBox x:Name="UserBox" Grid.Row="0" Grid.Column="1" IsEnabled="False" Margin="0,0,0,3" />

                <Label Grid.Row="1" Grid.Column="0" Content="Password:" VerticalAlignment="Center" Margin="0,0,6,0" />
                <PasswordBox x:Name="PasswordBox" Grid.Row="1" Grid.Column="1" IsEnabled="False" Padding="3,2" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
