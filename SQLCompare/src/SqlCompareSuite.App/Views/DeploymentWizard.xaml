<Window x:Class="SqlCompareSuite.App.Views.DeploymentWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Deployment Wizard" Width="960" Height="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource RgContentBg}">
    <DockPanel>
        <!-- ===== Header xanh gradient: Source ▶ Target ===== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource RgBanner}" Height="60">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                    <TextBlock Text="🛢" FontSize="24" Foreground="White" VerticalAlignment="Center" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Source" Foreground="White" FontWeight="Bold" FontSize="15" />
                        <TextBlock x:Name="HeaderSourceText" Text="" Foreground="#FBE0EC" FontSize="11" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="▶" Foreground="White" FontSize="20"
                           VerticalAlignment="Center" Margin="8,0" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="16,0">
                    <StackPanel Margin="0,0,10,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="Target" Foreground="White" FontWeight="Bold" FontSize="15" TextAlignment="Right" />
                        <TextBlock x:Name="HeaderTargetText" Text="" Foreground="#FBE0EC" FontSize="11" TextAlignment="Right" />
                    </StackPanel>
                    <TextBlock Text="🛢" FontSize="24" Foreground="White" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Footer tối: Back / primary / Close ===== -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource RgDark}" Padding="12,8">
            <Grid>
                <Button x:Name="BackButton" Content="&lt; Back" HorizontalAlignment="Left"
                        Click="BackButton_Click" MinWidth="90" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="NextButton" Content="Next &gt;" Style="{StaticResource PrimaryButton}"
                            Click="NextButton_Click" MinWidth="100" Margin="0,0,8,0" />
                    <Button x:Name="PrimaryActionButton" Content="Deploy" Style="{StaticResource PrimaryButton}"
                            Click="PrimaryActionButton_Click" MinWidth="120" Margin="0,0,8,0"
                            Background="#43A047" Visibility="Collapsed" />
                    <Button x:Name="CloseButton" Content="Close" Click="CloseButton_Click" MinWidth="90" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Thân: stepper trái + nội dung phải ===== -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Stepper dọc -->
            <Border Grid.Column="0" Background="#23282D">
                <StackPanel Margin="0,18,0,0">
                    <Border x:Name="Step1Chip" Padding="18,12" Background="{StaticResource RgBlue}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="①" FontSize="16" Foreground="White" VerticalAlignment="Center" />
                            <TextBlock Text="Deployment method" Foreground="White" Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="Step2Chip" Padding="18,12" Background="Transparent">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="②" FontSize="16" Foreground="#AAB2BA" VerticalAlignment="Center" />
                            <TextBlock Text="Dependencies" Foreground="#AAB2BA" Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border x:Name="Step3Chip" Padding="18,12" Background="Transparent">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="③" FontSize="16" Foreground="#AAB2BA" VerticalAlignment="Center" />
                            <TextBlock Text="Deploy" Foreground="#AAB2BA" Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Nội dung từng bước -->
            <Grid Grid.Column="1" Margin="18">

                <!-- ===== BƯỚC 1: Deployment method ===== -->
                <StackPanel x:Name="Page1">
                    <TextBlock Text="Choose how to deploy" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

                    <RadioButton x:Name="MethodToolRadio" GroupName="Method" IsChecked="True" Margin="0,4">
                        <StackPanel>
                            <TextBlock Text="Deploy using tool (chạy trực tiếp lên Target)" FontWeight="SemiBold" />
                            <TextBlock Text="Tool sẽ thực thi script ngay trên database Target."
                                       Foreground="#777" FontSize="11" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="MethodScriptRadio" GroupName="Method" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="Create a deployment script (chỉ tạo script)" FontWeight="SemiBold" />
                            <TextBlock Text="Chỉ sinh file .sql để bạn tự review/chạy sau."
                                       Foreground="#777" FontSize="11" />
                        </StackPanel>
                    </RadioButton>

                    <Border Margin="0,18,0,0" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                        <StackPanel>
                            <CheckBox x:Name="BackupChk" Content="Back up target before deployment" Margin="0,4" />
                            <CheckBox x:Name="RecompareChk" Content="Recompare after deployment" Margin="0,4" />
                            <CheckBox x:Name="SaveCopyChk" Content="Save a copy of the deployment script" Margin="0,4"
                                      Checked="SaveCopyChk_Toggled" Unchecked="SaveCopyChk_Toggled" />
                            <Grid Margin="22,4,0,0" IsEnabled="False" x:Name="SaveCopyPanel">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" VerticalAlignment="Center"
                                           Margin="0,0,8,6" />
                                <TextBox x:Name="SaveCopyNameBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,6"
                                         Text="deployment.sql" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Path:" VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <Grid Grid.Row="1" Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SaveCopyPathBox" Grid.Column="0" />
                                    <Button x:Name="BrowsePathButton" Grid.Column="1" Content="..." MinWidth="0"
                                            Padding="10,0" Margin="6,0,0,0" Click="BrowsePathButton_Click" />
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== BƯỚC 2: Dependencies ===== -->
                <StackPanel x:Name="Page2" Visibility="Collapsed">
                    <TextBlock Text="Dependencies" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <TextBlock x:Name="DependenciesHint" Text="No dependencies." Foreground="#555" Margin="0,0,0,8" />
                    <Border BorderBrush="#DDDDDD" BorderThickness="1" Background="White" Height="380">
                        <ListBox x:Name="DependenciesList" BorderThickness="0" />
                    </Border>
                </StackPanel>

                <!-- ===== BƯỚC 3: Deploy (tabs) ===== -->
                <Grid x:Name="Page3" Visibility="Collapsed">
                    <TabControl Background="Transparent" BorderThickness="0">
                        <!-- Tab: Deployment Script -->
                        <TabItem Header="Deployment Script">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <!-- Toolbar nhỏ -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,6,0,6">
                                    <Button x:Name="SaveScriptButton" Content="Save Script..." Click="SaveScriptButton_Click" />
                                    <Button x:Name="CopyScriptButton" Content="Copy" Click="CopyScriptButton_Click" Margin="6,0,0,0" />
                                    <TextBlock Text="Find:" VerticalAlignment="Center" Margin="16,0,6,0" />
                                    <TextBox x:Name="FindBox" Width="180" VerticalAlignment="Center"
                                             KeyDown="FindBox_KeyDown" ToolTip="Enter để tìm tiếp" />
                                    <Button x:Name="FindButton" Content="Find" Click="FindButton_Click" Margin="6,0,0,0" />
                                </StackPanel>
                                <Border Grid.Row="1" BorderBrush="#DDDDDD" BorderThickness="1">
                                    <RichTextBox x:Name="ScriptViewer" IsReadOnly="True"
                                                 FontFamily="Consolas" FontSize="12"
                                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                                 Background="White" />
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- Tab: Summary -->
                        <TabItem Header="Summary">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="SummaryHeader" Grid.Row="0" FontWeight="SemiBold" Margin="2,8,2,8" />
                                <Border Grid.Row="1" BorderBrush="#DDDDDD" BorderThickness="1" Background="White">
                                    <ListBox x:Name="SummaryList" BorderThickness="0" />
                                </Border>
                            </Grid>
                        </TabItem>

                        <!-- Tab: Warnings -->
                        <TabItem Header="Warnings">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="WarningsHeader" Grid.Row="0" FontWeight="SemiBold"
                                           Foreground="#8A6D00" Margin="2,8,2,8" Text="No warnings" />
                                <Border Grid.Row="1" BorderBrush="#E0A000" BorderThickness="1" Background="#FFF8E1">
                                    <ListBox x:Name="WarningsList" BorderThickness="0" Background="Transparent"
                                             Foreground="#B00000" />
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>

                <!-- Busy overlay -->
                <Border x:Name="BusyOverlay" Background="#80FFFFFF" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar Width="160" Height="14" IsIndeterminate="True" />
                        <TextBlock x:Name="BusyText" Text="Đang xử lý..." Foreground="#DD6294"
                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
