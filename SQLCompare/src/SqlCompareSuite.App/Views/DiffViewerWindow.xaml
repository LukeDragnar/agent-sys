<Window x:Class="SqlCompareSuite.App.Views.DiffViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Diff Viewer" Width="900" Height="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource RgContentBg}">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title (thanh tối kiểu Redgate) -->
        <Border Grid.Row="0" Background="{StaticResource RgDark}" Padding="10,6" CornerRadius="3" Margin="0,0,0,4">
            <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold"
                       Foreground="White" TextWrapping="Wrap" />
        </Border>
        <!-- Status -->
        <TextBlock x:Name="StatusText" Grid.Row="1" Foreground="#555"
                   TextWrapping="Wrap" Margin="2,0,0,6" />

        <!-- Content host: one of the panels below is shown -->
        <Grid Grid.Row="2">

            <!-- ===== Programmable (text) diff: 2 monospace TextBoxes ===== -->
            <Grid x:Name="ProgrammablePanel" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Source" FontWeight="SemiBold" Margin="2" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Target" FontWeight="SemiBold" Margin="2" />

                <TextBox x:Name="SourceDefBox" Grid.Row="1" Grid.Column="0" Margin="2"
                         IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                         AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         Background="#FAFAFA" />
                <TextBox x:Name="TargetDefBox" Grid.Row="1" Grid.Column="1" Margin="2"
                         IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                         AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         Background="#FAFAFA" />
            </Grid>

            <!-- ===== Table diff: 2 column lists + details ===== -->
            <Grid x:Name="TablePanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="120" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Source columns" FontWeight="SemiBold" Margin="2" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Target columns" FontWeight="SemiBold" Margin="2" />

                    <DataGrid x:Name="SourceColsGrid" Grid.Row="1" Grid.Column="0" Margin="2"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Column" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="160" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <DataGrid x:Name="TargetColsGrid" Grid.Row="1" Grid.Column="1" Margin="2"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Column" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="160" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <TextBlock Grid.Row="1" Text="Differences" FontWeight="SemiBold" Margin="2,8,2,2" />
                <TextBox x:Name="DetailsBox" Grid.Row="2" Margin="2"
                         IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                         AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         Background="#FAFAFA" />
            </Grid>

            <!-- ===== Data row diff: Column | Source | Target ===== -->
            <DataGrid x:Name="DataRowGrid" Visibility="Collapsed" Margin="2"
                      AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      GridLinesVisibility="All" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Column" Binding="{Binding Column}" Width="200" />
                    <DataGridTextColumn Header="Source Value" Binding="{Binding SourceValue}" Width="*" />
                    <DataGridTextColumn Header="Target Value" Binding="{Binding TargetValue}" Width="*" />
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDifferent}" Value="True">
                                <Setter Property="Background" Value="#FFE0E0" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Foreground" Value="#B00000" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </Grid>
    </Grid>
</Window>
