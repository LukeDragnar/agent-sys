<UserControl x:Class="SqlCompareSuite.App.Views.SchemaCompareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SqlCompareSuite.App.Views">
    <Grid Background="{StaticResource RgContentBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- 0: Banner Source ⇄ Target -->
            <RowDefinition Height="Auto" />
            <!-- 1: Action bar (Swap/Save/Load/Status) -->
            <RowDefinition Height="Auto" />
            <!-- 2: Options + snapshot -->
            <RowDefinition Height="Auto" />
            <!-- 3: Summary + select all/none -->
            <RowDefinition Height="*" />
            <!-- 4: Diff grid (grouped) -->
            <RowDefinition Height="Auto" />
            <!-- 5: Filter tabs (dark) -->
            <RowDefinition Height="1.4*" />
            <!-- 6: Side-by-side compare panel -->
            <RowDefinition Height="Auto" />
            <!-- 7: Script bar -->
            <RowDefinition Height="Auto" />
            <!-- 8: Script output -->
            <RowDefinition Height="Auto" />
            <!-- 9: Warnings -->
        </Grid.RowDefinitions>

        <!-- Panel kết nối CŨ: GIỮ LẠI để dùng logic Get/SetConnectionInfo, nhưng ẩn đi.
             Banner + dialog thao tác qua 2 panel này. -->
        <Grid Visibility="Collapsed">
            <views:ConnectionPanel x:Name="SourcePanel" Title="Source (left)" />
            <views:ConnectionPanel x:Name="TargetPanel" Title="Target (right)" />
        </Grid>

        <!-- ===================== BANNER Source ⇄ Target ===================== -->
        <Border Grid.Row="1" Margin="2,2,2,4" CornerRadius="4" BorderBrush="#DDDDDD" BorderThickness="1">
            <Grid Height="64" Background="Transparent" MouseLeftButtonDown="Banner_MouseDown"
                  ToolTip="Double-click để đảo chiều Source ⇄ Target">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Trái (vị trí cố định). Màu/vai trò đổi theo chiều (code-behind). -->
                <Border x:Name="LeftSideBorder" Grid.Column="0" Background="White" CornerRadius="4,0,0,4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                        <Border Width="40" Height="40" CornerRadius="20" Background="#FCE3EC">
                            <TextBlock Text="🛢" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="SourceServerLabel" Text="(no server)" FontWeight="Bold" FontSize="14" Foreground="#222" />
                            <TextBlock x:Name="SourceDbLabel" Text="(no database)" FontSize="12" Foreground="#666" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Giữa: bố cục Redgate — [Selected] cạnh [Deploy chevron], đảo bên theo chiều deploy -->
                <Grid Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- Selected count — code đổi cột (trái khi →, phải khi ←) -->
                    <StackPanel x:Name="SelectedPanel" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="Selected" FontSize="11" Foreground="#888" HorizontalAlignment="Center" />
                        <TextBlock x:Name="SelectedCountText" Text="0 of 0" FontSize="14" FontWeight="Bold"
                                   Foreground="#333" HorizontalAlignment="Center" />
                    </StackPanel>
                    <!-- Deploy = chevron xanh lớn; đảo hướng khi Swap (RenderTransform trong code) -->
                    <Grid x:Name="ChevronHost" Grid.Column="1" Width="172" Height="48">
                        <Polygon x:Name="DeployChevron" Fill="#43A047"
                                 Points="0,0 150,0 172,24 150,48 0,48" RenderTransformOrigin="0.5,0.5" />
                        <Button x:Name="DeployButton" Content="Deploy  ➡" Click="DeployButton_Click"
                                Background="Transparent" BorderThickness="0" Foreground="White"
                                FontWeight="Bold" FontSize="15" Cursor="Hand"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                ToolTip="Deploy theo chiều mũi tên (Source → Target). Double-click banner để đảo chiều.">
                            <!-- Template trong suốt: KHÔNG đổi nền khi hover/press (giữ chevron xanh) -->
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Grid>

                <!-- Phải (vị trí cố định). Màu/vai trò đổi theo chiều (code-behind). -->
                <Grid Grid.Column="2">
                    <Border x:Name="RightSideBorder" Background="{StaticResource RgBanner}" CornerRadius="0,4,4,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0">
                        <StackPanel Margin="0,0,12,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock x:Name="TargetServerLabel" Text="(no server)" FontWeight="Bold" FontSize="14"
                                       Foreground="White" TextAlignment="Right" />
                            <TextBlock x:Name="TargetDbLabel" Text="(no database)" FontSize="12"
                                       Foreground="#FBE0EC" TextAlignment="Right" />
                        </StackPanel>
                        <Border Width="40" Height="40" CornerRadius="20" Background="#C9527F">
                            <TextBlock Text="🛢" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ===================== Action bar (trên cùng) ===================== -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,2,2,4" VerticalAlignment="Center">
            <Button x:Name="CompareButton" Content="🔄 Refresh" Click="CompareButton_Click" Margin="0,0,8,0"
                    ToolTip="Chạy (lại) so sánh" FontWeight="SemiBold" />
            <Button x:Name="SwapButton" Content="⇄ Swap" Click="SwapButton_Click" />
            <Button x:Name="SaveProjectButton" Content="Save Project" Click="SaveProjectButton_Click" Margin="8,0,0,0" />
            <Button x:Name="LoadProjectButton" Content="Load Project" Click="LoadProjectButton_Click" Margin="4,0,0,0" />
            <Button x:Name="OptionsButton" Content="⚙ Options" Click="OptionsButton_Click" Margin="4,0,0,0"
                    ToolTip="Tuỳ chọn so sánh / lọc / snapshot (click mở)" />
            <Button x:Name="EditProjectButton" Content="✎ Edit project" Click="EditProjectButton_Click" Margin="4,0,0,0" />
            <Button x:Name="ViewDetailsTopButton" Content="🔍 View Details" Click="ViewDetailsButton_Click" Margin="4,0,0,0" />
            <TextBlock Text="🔍" VerticalAlignment="Center" Margin="12,0,2,0" Foreground="#888" />
            <TextBox x:Name="SearchBox" Width="170" VerticalAlignment="Center"
                     TextChanged="SearchBox_TextChanged" ToolTip="Tìm object theo tên (lọc danh sách trên)" />
            <ProgressBar x:Name="BusyBar" Width="120" Height="14" IsIndeterminate="True"
                         Visibility="Collapsed" Margin="10,0,0,0" VerticalAlignment="Center" />
            <TextBlock x:Name="BusyText" Text="Đang xử lý..." Foreground="#DD6294"
                       Visibility="Collapsed" VerticalAlignment="Center" Margin="6,0,0,0" />
            <TextBlock x:Name="StatusText" Text="" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#555" />
        </StackPanel>

        <!-- ===================== Options popup (mở từ nút ⚙ Options) ===================== -->
        <Popup x:Name="OptionsPopup" Grid.Row="2" PlacementTarget="{Binding ElementName=OptionsButton}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
            <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1" Padding="10" MaxWidth="800">
            <StackPanel Margin="6,4,6,4">
                <!-- Filter patterns -->
                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                    <TextBlock Text="Include patterns:" VerticalAlignment="Center" Width="110" />
                    <TextBox x:Name="IncludePatternsBox" Width="220" VerticalAlignment="Center"
                             ToolTip="Wildcard 'schema.name', phân tách bằng ';'. VD: dbo.*" />
                    <TextBlock Text="Exclude patterns:" VerticalAlignment="Center" Width="110" Margin="16,0,0,0" />
                    <TextBox x:Name="ExcludePatternsBox" Width="220" VerticalAlignment="Center"
                             ToolTip="Wildcard loại trừ, phân tách bằng ';'. VD: Audit.*" />
                </StackPanel>

                <!-- Ignore rules -->
                <WrapPanel Orientation="Horizontal" Margin="0,4,0,2">
                    <CheckBox x:Name="IgnoreWhiteSpaceChk" Content="Ignore white space" IsChecked="True" Margin="0,0,16,0" />
                    <CheckBox x:Name="IgnoreCommentsChk" Content="Ignore comments" Margin="0,0,16,0" />
                    <CheckBox x:Name="IgnoreConstraintNamesChk" Content="Ignore constraint names" Margin="0,0,16,0" />
                    <CheckBox x:Name="IgnoreCollationChk" Content="Ignore collation" Margin="0,0,16,0" />
                    <CheckBox x:Name="IgnoreIdentitySeedChk" Content="Ignore identity seed" Margin="0,0,16,0" />
                    <CheckBox x:Name="IgnoreFillFactorChk" Content="Ignore fill factor" IsChecked="True" Margin="0,0,16,0" />
                </WrapPanel>

                <!-- Lọc theo LOẠI object (giống Redgate) -->
                <TextBlock Text="Include object types:" FontWeight="SemiBold" Margin="0,6,0,2" />
                <WrapPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <CheckBox x:Name="TypeTableChk" Content="Tables" IsChecked="True" Margin="0,0,14,2" />
                    <CheckBox x:Name="TypeViewChk" Content="Views" IsChecked="True" Margin="0,0,14,2" />
                    <CheckBox x:Name="TypeProcChk" Content="Stored procedures" IsChecked="True" Margin="0,0,14,2" />
                    <CheckBox x:Name="TypeFuncChk" Content="Functions" IsChecked="True" Margin="0,0,14,2" />
                    <CheckBox x:Name="TypeTriggerChk" Content="Triggers" IsChecked="True" Margin="0,0,14,2" />
                    <CheckBox x:Name="TypeSequenceChk" Content="Sequences" IsChecked="True" Margin="0,0,14,2" />
                    <CheckBox x:Name="TypeSynonymChk" Content="Synonyms" IsChecked="True" Margin="0,0,14,2" />
                    <CheckBox x:Name="TypeSchemaChk" Content="Schemas" IsChecked="True" Margin="0,0,14,2" />
                    <CheckBox x:Name="TypeUserChk" Content="Users" IsChecked="True" Margin="0,0,14,2" />
                    <CheckBox x:Name="TypeRoleChk" Content="Roles" IsChecked="True" Margin="0,0,14,2" />
                    <CheckBox x:Name="TypePermissionChk" Content="Permissions" IsChecked="True" Margin="0,0,14,2" />
                    <CheckBox x:Name="TypePartFuncChk" Content="Partition functions" IsChecked="True" Margin="0,0,14,2" />
                    <CheckBox x:Name="TypePartSchemeChk" Content="Partition schemes" IsChecked="True" Margin="0,0,14,2" />
                </WrapPanel>

                <!-- Script options -->
                <WrapPanel Orientation="Horizontal" Margin="0,4,0,2">
                    <CheckBox x:Name="WrapInTransactionChk" Content="Redgate-style deploy script (transaction + guards)" IsChecked="True" Margin="0,0,16,0"
                              ToolTip="Bọc script deploy theo phong cách Redgate: header + SET options + transaction + IF @@ERROR guard + PRINT" />
                    <CheckBox x:Name="IncludeDropsChk" Content="Include drops" IsChecked="True" Margin="0,0,16,0" />
                </WrapPanel>

                <!-- Snapshot bar -->
                <WrapPanel Orientation="Horizontal" Margin="0,6,0,2">
                    <Button x:Name="SaveSourceSnapshotButton" Content="Save Source Snapshot" Click="SaveSourceSnapshotButton_Click" Margin="0,0,4,0" />
                    <Button x:Name="SaveTargetSnapshotButton" Content="Save Target Snapshot" Click="SaveTargetSnapshotButton_Click" Margin="0,0,12,0" />
                    <Button x:Name="LoadSourceSnapshotButton" Content="Load Snapshot as Source" Click="LoadSourceSnapshotButton_Click" Margin="0,0,4,0" />
                    <Button x:Name="LoadTargetSnapshotButton" Content="Load Snapshot as Target" Click="LoadTargetSnapshotButton_Click" Margin="0,0,12,0" />
                    <Button x:Name="LoadScriptFolderSourceButton" Content="Load Script Folder as Source" Click="LoadScriptFolderSourceButton_Click" Margin="0,0,4,0" />
                    <Button x:Name="LoadScriptFolderTargetButton" Content="...as Target" Click="LoadScriptFolderTargetButton_Click" Margin="0,0,12,0" />
                    <Button x:Name="ClearSnapshotButton" Content="Clear snapshot" Click="ClearSnapshotButton_Click" />
                    <Button x:Name="ExportReportButton" Content="Export Report" Click="ExportReportButton_Click" Margin="12,0,0,0" />
                </WrapPanel>
                <TextBlock x:Name="SnapshotInfoText" Text="" Foreground="#DD6294" Margin="0,2,0,0" TextWrapping="Wrap" />
            </StackPanel>
            </Border>
        </Popup>

        <!-- ===================== Summary + select ===================== -->
        <!-- Đã có master checkbox ở header → ẩn dòng Select All/None/View Details (giữ nút cho SetBusy + FilterCombo) -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="2,0,2,2" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock x:Name="SummaryText" Visibility="Collapsed" />
            <Button x:Name="SelectAllButton" Content="Select All" Click="SelectAllButton_Click"
                    Padding="6,1" FontSize="11" Margin="0,0,4,0" />
            <Button x:Name="SelectNoneButton" Content="Select None" Click="SelectNoneButton_Click"
                    Padding="6,1" FontSize="11" Margin="0,0,4,0" />
            <Button x:Name="ViewDetailsButton" Content="View Details" Click="ViewDetailsButton_Click"
                    Padding="6,1" FontSize="11" />

            <!-- FilterCombo CŨ: GIỮ để RowFilter dùng SelectedIndex, nhưng ẩn.
                 Các filter tab (dưới) sẽ set SelectedIndex của combo này. -->
            <ComboBox x:Name="FilterCombo" Width="0" SelectedIndex="0" Visibility="Collapsed"
                      SelectionChanged="FilterCombo_SelectionChanged">
                <ComboBoxItem Content="All" />
                <ComboBoxItem Content="Only different" />
                <ComboBoxItem Content="Only in source" />
                <ComboBoxItem Content="Only in target" />
                <ComboBoxItem Content="Identical" />
            </ComboBox>
        </StackPanel>

        <!-- ===================== Diff grid (grouped) ===================== -->
        <DataGrid x:Name="DiffGrid" Grid.Row="4" Margin="2"
                  AutoGenerateColumns="False" CanUserAddRows="False"
                  IsReadOnly="False" SelectionMode="Single"
                  HeadersVisibility="Column"
                  HorizontalScrollBarVisibility="Disabled"
                  SizeChanged="DiffGrid_SizeChanged"
                  SelectionChanged="DiffGrid_SelectionChanged"
                  MouseDoubleClick="DiffGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <!-- Loại object: icon + tên loại (Table / View / Stored procedure...) -->
                <DataGridTemplateColumn Header="Type" Width="120" SortMemberPath="TypeText">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" ToolTip="{Binding StatusText}">
                                <TextBlock Text="{Binding TypeIcon}" Margin="2,0,6,0" VerticalAlignment="Center" FontSize="13" />
                                <TextBlock Text="{Binding TypeText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- Object name (source) — căn phải, width tính bằng code -->
                <DataGridTextColumn x:Name="ObjColSource" Header="Object name" Binding="{Binding Name}" Width="260" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right" />
                            <Setter Property="Margin" Value="0,0,6,0" />
                            <Setter Property="ToolTip" Value="{Binding Name}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <!-- Modified (S): nằm NGAY cạnh Object name (source) — mỗi bên có ngày sửa riêng -->
                <DataGridTextColumn Header="Modified (S)" Binding="{Binding SourceModifiedText}" Width="130" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#888888" />
                            <Setter Property="Margin" Value="6,0,0,0" />
                            <Setter Property="FontSize" Value="11" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <!-- ☑ Include — Ở GIỮA. Header = master checkbox (tristate: all/none/1 phần). -->
                <DataGridTemplateColumn Width="44" CanUserSort="False">
                    <DataGridTemplateColumn.Header>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <CheckBox x:Name="HeaderCheckBox" IsThreeState="False" Click="HeaderCheckBox_Click"
                                      VerticalAlignment="Center" ToolTip="Chọn / bỏ chọn tất cả" />
                            <TextBlock x:Name="IncludeDirArrow" Text="→" FontSize="13" FontWeight="Bold"
                                       Foreground="#43A047" VerticalAlignment="Center" Margin="2,0,0,0"
                                       ToolTip="Chiều deploy (Source → Target)" />
                        </StackPanel>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!-- Identical (dấu =) → ẩn checkbox, không cần deploy -->
                            <CheckBox IsChecked="{Binding Include, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Visibility="{Binding IncludeCheckVisibility}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- Object name (target) — căn trái, width tính bằng code -->
                <DataGridTextColumn x:Name="ObjColTarget" Header="Object name" Binding="{Binding Name}" Width="260" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Margin" Value="6,0,0,0" />
                            <Setter Property="ToolTip" Value="{Binding Name}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <!-- Modified (T): nằm NGAY cạnh Object name (target) -->
                <DataGridTextColumn Header="Modified (T)" Binding="{Binding TargetModifiedText}" Width="130" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#888888" />
                            <Setter Property="Margin" Value="6,0,0,0" />
                            <Setter Property="FontSize" Value="11" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>

            <!-- Nhóm theo StatusText: group header dạng "Different (21)" -->
            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="{x:Type GroupItem}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type GroupItem}">
                                        <StackPanel>
                                            <!-- Header nhóm: Grid khớp cột data (Type 120 | nameS * | Mod(S) 130 | Include 44 | nameT * | Mod(T) 130) → ☑ thẳng cột Include -->
                                            <Border Background="{StaticResource RgGroupHeader}" BorderBrush="#D5D5D5"
                                                    BorderThickness="0,0,0,1" Cursor="Hand"
                                                    MouseLeftButtonUp="GroupHeader_MouseUp">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="130" />
                                                        <ColumnDefinition Width="44" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="130" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                                                                VerticalAlignment="Center" Margin="4,2,0,2">
                                                        <ToggleButton x:Name="GroupToggle" IsChecked="True" Focusable="False"
                                                                      Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                                      Padding="2,0">
                                                            <TextBlock x:Name="ToggleGlyph" Text="▼" FontSize="9" Foreground="#666" />
                                                        </ToggleButton>
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                                                   Foreground="{StaticResource RgGroupHeaderText}" Margin="2,0,0,0" />
                                                        <TextBlock Text=" (" Foreground="#666" />
                                                        <TextBlock Text="{Binding ItemCount}" Foreground="#666" />
                                                        <TextBlock Text=")" Foreground="#666" />
                                                    </StackPanel>
                                                    <!-- Count "sel/total" — cột Mod(S), căn phải → sát ngay TRÁI checkbox Include -->
                                                    <TextBlock Grid.Column="2" Loaded="GroupCount_Loaded" Foreground="#1E8A4C"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                                               Margin="0,0,6,0" FontSize="11" FontWeight="SemiBold" />
                                                    <!-- ☑ cả nhóm — tristate, thẳng hàng cột Include (giờ là cột index 3) -->
                                                    <CheckBox Grid.Column="3" IsThreeState="False" Loaded="GroupCheck_Loaded"
                                                              Click="GroupCheck_Click" HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" ToolTip="Tick/bỏ cả nhóm để deploy" />
                                                </Grid>
                                            </Border>
                                            <ItemsPresenter x:Name="GroupItemsHost" />
                                        </StackPanel>
                                        <ControlTemplate.Triggers>
                                            <Trigger SourceName="GroupToggle" Property="IsChecked" Value="False">
                                                <Setter TargetName="GroupItemsHost" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="ToggleGlyph" Property="Text" Value="►" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
            </DataGrid.GroupStyle>
        </DataGrid>

        <!-- ===================== Splitter resize giữa danh sách (trên) và panel so sánh (dưới) ===================== -->
        <GridSplitter Grid.Row="5" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="#C8C8C8" Margin="2,0" />

        <!-- ===================== Side-by-side compare panel (gồm filter tabs ở trên) ===================== -->
        <Border Grid.Row="6" Margin="2,0,2,4" BorderBrush="#DDDDDD" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <!-- filter tabs -->
                    <RowDefinition Height="Auto" />
                    <!-- diff header toolbar -->
                    <RowDefinition Height="*" />
                    <!-- nội dung diff -->
                    <RowDefinition Height="Auto" />
                    <!-- find bar -->
                </Grid.RowDefinitions>

                <!-- Filter tabs (dark) -->
                <Border Grid.Row="0" Background="{StaticResource RgDark}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="FilterTabAll" Style="{StaticResource FilterTab}" Content="All"
                                     GroupName="Filter" Tag="0" IsChecked="True" Checked="FilterTab_Checked" />
                        <RadioButton x:Name="FilterTabSource" Style="{StaticResource FilterTab}" Content="Only in Source"
                                     GroupName="Filter" Tag="2" Checked="FilterTab_Checked" />
                        <RadioButton x:Name="FilterTabDifferent" Style="{StaticResource FilterTab}" Content="In both but different"
                                     GroupName="Filter" Tag="1" Checked="FilterTab_Checked" />
                        <RadioButton x:Name="FilterTabTarget" Style="{StaticResource FilterTab}" Content="Only in Target"
                                     GroupName="Filter" Tag="3" Checked="FilterTab_Checked" />
                        <RadioButton x:Name="FilterTabIdentical" Style="{StaticResource FilterTab}" Content="Identical"
                                     GroupName="Filter" Tag="4" Checked="FilterTab_Checked" />
                    </StackPanel>
                </Border>

                <!-- Header tối kiểu Redgate: ⚙ (cỡ chữ) | Previous | Next | title -->
                <Border Grid.Row="1" Background="{StaticResource RgDark}" Padding="2">
                    <DockPanel LastChildFill="True">
                        <Menu DockPanel.Dock="Left" Background="Transparent" VerticalAlignment="Center">
                            <MenuItem Header="⚙" Foreground="White" Padding="6,2" ToolTip="Tuỳ chọn hiển thị">
                                <MenuItem Header="Text: Tiny"   Tag="10" Click="DiffTextSize_Click" Foreground="#222222" />
                                <MenuItem Header="Text: Small"  Tag="12" Click="DiffTextSize_Click" Foreground="#222222" />
                                <MenuItem Header="Text: Medium" Tag="14" Click="DiffTextSize_Click" Foreground="#222222" />
                            </MenuItem>
                        </Menu>
                        <Button DockPanel.Dock="Left" Content="⬆ Previous" Click="DiffPrev_Click"
                                Style="{StaticResource ToolbarIconButton}" VerticalAlignment="Center"
                                ToolTip="Object khác biệt trước" />
                        <Button DockPanel.Dock="Left" Content="⬇ Next" Click="DiffNext_Click"
                                Style="{StaticResource ToolbarIconButton}" VerticalAlignment="Center"
                                ToolTip="Object khác biệt kế" />
                        <TextBlock x:Name="SidePanelTitle" Foreground="White" FontFamily="Consolas"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Text="(chọn 1 dòng để xem so sánh)" />
                    </DockPanel>
                </Border>

                <!-- Nội dung: 2 ô definition side-by-side + 2 grid cột (table) -->
                <Grid Grid.Row="2">
                    <!-- Programmable / definition text: left | gutter mũi tên | right -->
                    <Grid x:Name="SideProgrammablePanel" Visibility="Visible">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <RichTextBox x:Name="SideSourceDef" Grid.Column="0" Margin="2"
                                     Padding="0" BorderThickness="0"
                                     IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     Background="{StaticResource RgContentBg}" />

                        <!-- Gutter mũi tên giữa 2 bên: cuộn ẩn, đồng bộ với 2 RichTextBox -->
                        <ScrollViewer x:Name="SideGutterScroll" Grid.Column="1" Margin="0,2"
                                      VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                                      Background="#F7F9FB">
                            <ItemsControl x:Name="SideGutter">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Glyph}" Foreground="{Binding Foreground}"
                                                   Height="{Binding LineHeight}" FontFamily="Consolas" FontSize="12"
                                                   TextAlignment="Center" HorizontalAlignment="Stretch" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <RichTextBox x:Name="SideTargetDef" Grid.Column="2" Margin="2"
                                     Padding="0" BorderThickness="0"
                                     IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                                     IsInactiveSelectionHighlightEnabled="True"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                     Background="{StaticResource RgContentBg}" />
                    </Grid>

                    <!-- Table: 1 grid căn hàng (Source col | type | ⇄ | Target col | type) — CHỈ 1 scroll -->
                    <DataGrid x:Name="SideTableGrid" Visibility="Collapsed" Margin="2"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              HeadersVisibility="Column" HorizontalScrollBarVisibility="Disabled"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Source column" Binding="{Binding SourceName}" Width="*" />
                            <DataGridTextColumn Header="Type" Binding="{Binding SourceType}" Width="130" />
                            <DataGridTextColumn Header="" Binding="{Binding Arrow}" Width="28" />
                            <DataGridTextColumn Header="Target column" Binding="{Binding TargetName}" Width="*" />
                            <DataGridTextColumn Header="Type" Binding="{Binding TargetType}" Width="130" />
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDifferent}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource RgDiffCell}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </Grid>

                <!-- ===== Find bar: tìm trong định nghĩa (target) ===== -->
                <Border Grid.Row="3" Background="#F0F0F0" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="4,3">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Left" Text="🔍" VerticalAlignment="Center" Margin="2,0,5,0" Foreground="#666" />
                        <Button DockPanel.Dock="Right" Content="✕" Click="FindClose_Click" Width="24" Margin="3,0,0,0" ToolTip="Xóa tìm" />
                        <Button DockPanel.Dock="Right" Content="▼" Click="FindNext_Click" Width="26" ToolTip="Tìm tiếp (Enter)" />
                        <Button DockPanel.Dock="Right" Content="▲" Click="FindPrev_Click" Width="26" Margin="0,0,2,0" ToolTip="Tìm lùi (Shift+Enter)" />
                        <TextBlock DockPanel.Dock="Right" x:Name="FindStatus" VerticalAlignment="Center" Margin="8,0,6,0" Foreground="#888" MinWidth="36" />
                        <TextBox x:Name="FindBox" KeyDown="FindBox_KeyDown" TextChanged="FindBox_TextChanged"
                                 VerticalAlignment="Center"
                                 ToolTip="Tìm trong định nghĩa bên phải (target). Enter = tìm tiếp, Shift+Enter = lùi" />
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Script/Copy/Save/Execute + output + warnings: ẩn ở main view → BẮT BUỘC qua nút Deploy (wizard).
             Vẫn giữ trong cây để code-behind set ScriptBox/WarningsList (wizard nhận từ đó). -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" Margin="2,2,2,4" Visibility="Collapsed">
            <Button x:Name="GenerateButton" Content="Generate Sync Script (Target ← Source)"
                    Click="GenerateButton_Click" MinWidth="240" />
            <Button x:Name="CopyButton" Content="Copy" Click="CopyButton_Click" />
            <Button x:Name="SaveButton" Content="Save .sql" Click="SaveButton_Click" />
            <Button x:Name="ExecuteButton" Content="Execute on Target" Click="ExecuteButton_Click"
                    Margin="12,0,0,0" Background="#FFE0E0" />
        </StackPanel>

        <TextBox x:Name="ScriptBox" Grid.Row="8" Margin="2" Height="110" Visibility="Collapsed"
                 IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                 TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 Background="{StaticResource RgContentBg}" />

        <Border Grid.Row="9" Margin="2,4,2,2" BorderBrush="#E0A000" BorderThickness="1"
                Background="#FFF8E1" Padding="4" MaxHeight="100" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="WarningsHeader" Text="No warnings" FontWeight="SemiBold" Foreground="#8A6D00" />
                <ListBox x:Name="WarningsList" BorderThickness="0" Background="Transparent"
                         Foreground="#B00000" MaxHeight="72" Visibility="Collapsed"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
